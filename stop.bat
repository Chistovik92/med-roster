@echo off
rem ============================================================
rem  Остановка сервиса «МедГрафик: Поликлиника» (Windows).
rem  Находит процесс, слушающий порт 25625, и завершает его.
rem  Запуск: двойной клик по stop.bat (или из командной строки).
rem ============================================================
setlocal
set PORT=25625

echo ==========================================
echo   Остановка «МедГрафик: Поликлиника»
echo ==========================================
echo.

set FOUND=0
for /f "tokens=5" %%P in ('netstat -aon ^| findstr ":%PORT% " ^| findstr "LISTENING"') do (
    echo   Завершаю процесс PID %%P ...
    taskkill /PID %%P /F >nul 2>&1
    set FOUND=1
)

if "%FOUND%"=="1" (
    echo.
    echo Готово. Сервис остановлен.
) else (
    echo Сервис не запущен (порт %PORT% свободен).
)
echo.
pause
endlocal
